{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sanhuu Pet",
  "version": "1.1.0",
  "identifier": "com.sanhuu.pet",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "三虎桌宠",
        "url": "index.html",
        "width": 520,
        "height": 760,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "center": true,
        "skipTaskbar": false
      },
      {
        "label": "overlay",
        "title": "picker",
        "url": "overlay.html",
        "width": 100,
        "height": 100,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "三虎桌宠 Sanhuu Pet",
    "longDescription": "以「三虎 Sanhuu」为主角的像素风桌面宠物：截图录屏、格式转换、压缩解压、定时提醒、待办、天气下雨预警。",
    "category": "Entertainment",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
